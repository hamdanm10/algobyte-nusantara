<header class="max-w-7xl mx-auto px-4 pt-32 pb-16">
  <div class="flex flex-col space-y-6 max-w-2xl">
    <div class="rounded px-6 py-1 bg-white border border-gray-800 text-gray-800 text-xs flex gap-1 items-center uppercase shadow-md w-fit">
      <%= lucide_icon("newspaper", class: "size-5", 'stroke-width' => '1.5') %>
      <span>Articles</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-800">Insights on <span class="underline decoration-orange-600">Technology</span> & Software</h1>
    <p class="text-base md:text-lg text-gray-600">Practical articles on software development, system design, and the technology decisions we encounter when building real products.</p>
  </div>
</header>
