<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-10 px-6 md:py-16 md:px-12 shadow-md bg-white flex flex-col items-center text-center gap-8">
    <div class="flex flex-col items-center gap-4">
      <span class="w-fit bg-amber-200 px-2 font-semibold text-gray-800">Work With Us</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Have a Project in Mind?</h2>
      <p class="text-gray-600 text-base md:text-lg max-w-2xl">Reading about good software is one thing. Let's build yours together.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to "Start a Project", contact_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-rose-400" %>
      <%= link_to "Our Services", services_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-orange-600" %>
    </div>
  </div>
</section>
