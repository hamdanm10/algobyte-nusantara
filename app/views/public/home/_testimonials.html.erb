<section id="testimonials" class="max-w-7xl mx-auto py-20">
  <div class="border border-gray-800 rounded py-8 px-6 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4 w-1/2">
      <span class="w-fit bg-red-200 px-2 font-semibold text-gray-800">Testimonials</span>
      <h2 class="text-4xl font-bold text-gray-800">What Our Clients Say</h2>
      <p class="text-gray-600 text-lg">Real feedback from clients who have trusted us to deliver their digital solutions.</p>
    </div>
    <div class="grid grid-cols-3 gap-6">
      <%= render Public::TestimonialCardComponent.new(
        quote: "The Algobyte team is highly professional and responsive. The system they built is stable, secure, and truly aligned with our business needs.",
        name: "Irfan",
        role: "Founder, Bangkit Belajar",
        initials: "I"
      ) %>
      <%= render Public::TestimonialCardComponent.new(
        quote: "The quality of their work and documentation is exceptionally maintained. The collaboration process was transparent from start to finish, and the results exceeded our expectations.",
        name: "Dian Purnomo Aji",
        role: "Staff IT, Ikatel",
        initials: "DP"
      ) %>
      <%= render Public::TestimonialCardComponent.new(
        quote: "Algobyte is not only technically competent, but also has a strong understanding of the business context. The solutions they deliver have made a real impact on our operations.",
        name: "Aris Darajat Mulya",
        role: "Kepala Program RPL, Yayasan Bina Wisata Lembang",
        initials: "AD"
      ) %>
    </div>
  </div>
</section>
