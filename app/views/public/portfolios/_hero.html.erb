<header class="max-w-7xl mx-auto px-4 pt-36 pb-20">
  <div class="flex flex-col items-start space-y-8 max-w-2xl">
    <div class="rounded px-6 py-1 bg-white border border-gray-800 text-gray-800 text-xs flex gap-1 items-center uppercase shadow-md">
      <%= lucide_icon("folder-open", class: "size-5", 'stroke-width' => '1.5') %>
      <span>Our Work</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-800">Projects We're <span class="underline decoration-orange-600">Proud</span> to Have Built</h1>
    <p class="text-base md:text-lg text-gray-600">A selection of projects across industries — each one a collaboration built on clear requirements, solid engineering, and a commitment to long-term quality.</p>
    <div class="flex flex-wrap gap-4">
      <%= link_to "Start a Project", contact_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-orange-600" %>
    </div>
  </div>
</header>
