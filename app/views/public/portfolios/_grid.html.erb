<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-8 px-6 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4 w-full md:w-1/2">
      <span class="w-fit bg-amber-200 px-2 font-semibold text-gray-800">Portfolio</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">10+ Projects Delivered</h2>
      <p class="text-gray-600 text-base md:text-lg">From internal tools to client-facing platforms — here's a snapshot of what we've shipped.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render Public::PortfolioCardComponent.new(
        title: "Bangkit Belajar Platform",
        category: "Web Application",
        description: "A learning management system built for Bangkit Belajar, supporting course management, student progress tracking, and instructor dashboards.",
        tags: ["Ruby on Rails", "PostgreSQL", "Hotwire"]
      ) %>
      <%= render Public::PortfolioCardComponent.new(
        title: "Ikatel IT System",
        category: "Software Development",
        description: "Internal IT management system for Ikatel, streamlining asset tracking, service requests, and reporting across multiple departments.",
        tags: ["Rails", "Tailwind CSS", "Stimulus"]
      ) %>
      <%= render Public::PortfolioCardComponent.new(
        title: "RPL Management System",
        category: "Web Application",
        description: "Student and program management platform for Yayasan Bina Wisata Lembang, covering enrollment, scheduling, and academic reporting.",
        tags: ["Ruby on Rails", "PostgreSQL", "Hotwire"]
      ) %>
      <%= render Public::PortfolioCardComponent.new(
        title: "Company Profile & CMS",
        category: "Web Development",
        description: "A modern company profile website with a content management system, allowing clients to update news, services, and portfolios independently.",
        tags: ["Rails", "Tailwind CSS", "Propshaft"]
      ) %>
      <%= render Public::PortfolioCardComponent.new(
        title: "Invoice & Finance System",
        category: "Software Development",
        description: "Automated invoice generation and financial tracking system for a local business, integrated with tax reporting workflows.",
        tags: ["Rails", "PDF Generation", "PostgreSQL"]
      ) %>
      <%= render Public::PortfolioCardComponent.new(
        title: "Mobile Application",
        category: "Android / iOS",
        description: "Cross-platform mobile application with real-time notifications, offline support, and a native-feel UI for both Android and iOS.",
        tags: ["Flutter", "REST API", "Firebase"]
      ) %>
    </div>
  </div>
</section>
