<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="flex flex-col space-y-6">
    <div class="flex flex-col space-y-4 w-full md:w-1/2 md:items-end md:text-right md:ml-auto">
      <span class="w-fit bg-orange-200 px-2 font-semibold text-gray-800">How We Work</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">A Process Built for Clarity</h2>
      <p class="text-gray-600 text-base md:text-lg">No surprises. Every project follows a structured process that keeps you informed and in control from start to finish.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="border border-gray-800 rounded px-4 py-6 flex flex-col gap-4">
        <span class="text-4xl font-bold text-gray-200">01</span>
        <div class="bg-white rounded border border-gray-800 w-10 h-10 flex items-center justify-center">
          <%= lucide_icon("message-square", class: "text-gray-800 size-4") %>
        </div>
        <h4 class="text-gray-800 font-bold">Discovery</h4>
        <p class="text-sm text-gray-600">We learn about your business, goals, and challenges through in-depth consultation.</p>
      </div>
      <div class="border border-gray-800 rounded px-4 py-6 flex flex-col gap-4">
        <span class="text-4xl font-bold text-gray-200">02</span>
        <div class="bg-white rounded border border-gray-800 w-10 h-10 flex items-center justify-center">
          <%= lucide_icon("pencil-ruler", class: "text-gray-800 size-4") %>
        </div>
        <h4 class="text-gray-800 font-bold">Design & Plan</h4>
        <p class="text-sm text-gray-600">We design the architecture, UI, and project roadmap before writing a single line of code.</p>
      </div>
      <div class="border border-gray-800 rounded px-4 py-6 flex flex-col gap-4">
        <span class="text-4xl font-bold text-gray-200">03</span>
        <div class="bg-white rounded border border-gray-800 w-10 h-10 flex items-center justify-center">
          <%= lucide_icon("code-2", class: "text-gray-800 size-4") %>
        </div>
        <h4 class="text-gray-800 font-bold">Build & Test</h4>
        <p class="text-sm text-gray-600">Development with iterative testing at every stage to catch issues early and maintain quality.</p>
      </div>
      <div class="border border-gray-800 rounded px-4 py-6 flex flex-col gap-4">
        <span class="text-4xl font-bold text-gray-200">04</span>
        <div class="bg-white rounded border border-gray-800 w-10 h-10 flex items-center justify-center">
          <%= lucide_icon("rocket", class: "text-gray-800 size-4") %>
        </div>
        <h4 class="text-gray-800 font-bold">Launch & Support</h4>
        <p class="text-sm text-gray-600">We deploy, monitor, and provide ongoing support to keep your system stable and performant.</p>
      </div>
    </div>
  </div>
</section>
