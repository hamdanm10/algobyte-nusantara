<header class="max-w-7xl mx-auto px-4 pt-36 pb-20">
  <div class="flex flex-col items-start space-y-8 max-w-2xl">
    <div class="rounded px-6 py-1 bg-white border border-gray-800 text-gray-800 text-xs flex gap-1 items-center uppercase shadow-md">
      <%= lucide_icon("mail", class: "size-5", 'stroke-width' => '1.5') %>
      <span>Get in Touch</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-800">Let's Talk About <span class="underline decoration-orange-600">Your Project</span></h1>
    <p class="text-base md:text-lg text-gray-600">Whether you have a specific project in mind or just want to explore how we can help — send us a message and we'll get back to you within one business day.</p>
  </div>
</header>
