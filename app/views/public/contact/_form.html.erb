<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-8 px-6 md:px-12 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4 w-full md:w-1/2">
      <span class="w-fit bg-amber-200 px-2 font-semibold text-gray-800">Send a Message</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Tell Us About Your Project</h2>
      <p class="text-gray-600 text-base md:text-lg">The more detail you share, the better we can tailor our response.</p>
    </div>
    <form class="flex flex-col gap-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-gray-800" for="name">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Your full name"
            class="border border-gray-800 rounded px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:border-transparent transition duration-300">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-gray-800" for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="your@email.com"
            class="border border-gray-800 rounded px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:border-transparent transition duration-300">
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-gray-800" for="company">Company / Organization <span class="text-gray-400 font-normal">(optional)</span></label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="Your company name"
            class="border border-gray-800 rounded px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:border-transparent transition duration-300">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-gray-800" for="service">Service Needed</label>
          <select
            id="service"
            name="service"
            class="border border-gray-800 rounded px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:border-transparent transition duration-300 bg-white">
            <option value="" disabled selected>Select a service</option>
            <option value="software">Software Development</option>
            <option value="infrastructure">IT Infrastructure</option>
            <option value="uiux">UI/UX Design</option>
            <option value="mobile">Android / iOS Development</option>
            <option value="web">Web Application Development</option>
            <option value="maintenance">Maintenance Support</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-gray-800" for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Tell us about your project, goals, timeline, or any questions you have..."
          class="border border-gray-800 rounded px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:border-transparent transition duration-300 resize-none"></textarea>
      </div>
      <div>
        <button
          type="submit"
          class="inline-block bg-white text-gray-800 border border-gray-800 px-8 py-3 rounded transition duration-300 hover:-rotate-2 hover:shadow-lg hover:shadow-orange-600 font-medium">
          Send Message
        </button>
      </div>
    </form>
  </div>
</section>
