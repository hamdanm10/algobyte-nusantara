      ) %>
      <%= render Public::TeamMemberComponent.new(
        name: "Zen Mustaofa",
        role: "Manajer Operasional",
        initials: "ZM",
        bio: "Manages operational workflows and team coordination to ensure every project is delivered on time and to standard."
      ) %>
      <%= render Public::TeamMemberComponent.new(
        name: "Herdi Rudian",
        role: "Manajer Keuangan",
        initials: "HR",
        bio: "Manages company finances with accountability and transparency to support healthy and sustainable business growth."
