<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="flex flex-col space-y-6">
    <div class="flex flex-col space-y-4 w-full md:w-1/2 md:items-end md:text-right md:ml-auto">
      <span class="w-fit bg-red-200 px-2 font-semibold text-gray-800">Our Values</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">What We Stand For</h2>
      <p class="text-gray-600 text-base md:text-lg">The principles that guide every line of code we write and every client relationship we build.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="hidden md:flex items-center justify-center">
        <canvas
          data-controller="lottie"
          data-lottie-src-value="<%= asset_path('animation-3.lottie') %>"
          class="w-full h-full">
        </canvas>
      </div>
      <div class="flex flex-col gap-3">
        <%= render Public::FeatureItemComponent.new(icon: "award", title: "Professionalism", description: "Structured, responsible, and reliable quality work in every project we take on.") %>
        <%= render Public::FeatureItemComponent.new(icon: "shield-check", title: "Security First", description: "Security, stability, and performance are non-negotiable — built in from day one, not bolted on later.") %>
        <%= render Public::FeatureItemComponent.new(icon: "handshake", title: "Honest Partnership", description: "Transparent communication and consistent results build the trust that makes long-term collaboration possible.") %>
        <%= render Public::FeatureItemComponent.new(icon: "star", title: "Best Practice", description: "Industry standards and proven patterns guide our development — because quality compounds over time.") %>
      </div>
    </div>
  </div>
</section>
