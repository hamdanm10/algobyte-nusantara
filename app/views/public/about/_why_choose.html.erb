<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-8 px-6 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4">
      <span class="w-fit bg-green-200 px-2 font-semibold text-gray-800">Why Algobyte</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Why Industry Leaders Choose Algobyte</h2>
      <p class="text-gray-600 text-base md:text-lg max-w-2xl">We don't just build software — we build confidence. Here's why businesses across Indonesia trust us to deliver.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= render Public::FeatureItemComponent.new(
        icon: "code-2",
        title: "Deep Technical Expertise",
        description: "Our engineers bring years of hands-on experience across web, API, and infrastructure — so you get solutions that actually hold up in production."
      ) %>
      <%= render Public::FeatureItemComponent.new(
        icon: "shield",
        title: "Security Built In",
        description: "Security is never an afterthought. Every system we build is hardened from day one, so your data and your clients' data stay protected."
      ) %>
      <%= render Public::FeatureItemComponent.new(
        icon: "clock",
        title: "Reliable Delivery",
        description: "We set realistic timelines and we meet them. No surprises, no scope creep, no disappearing acts mid-project."
      ) %>
      <%= render Public::FeatureItemComponent.new(
        icon: "eye",
        title: "Full Transparency",
        description: "You always know what we're working on, what's next, and why. Open communication is how we build trust that lasts."
      ) %>
      <%= render Public::FeatureItemComponent.new(
        icon: "refresh-cw",
        title: "Long-Term Support",
        description: "We don't vanish after launch. We stay on to maintain, improve, and scale your system as your business grows."
      ) %>
      <%= render Public::FeatureItemComponent.new(
        icon: "map-pin",
        title: "Local, Contextual Knowledge",
        description: "We understand the Indonesian market, regulations, and business landscape — and we build solutions that fit your real operating environment."
      ) %>
    </div>
  </div>
</section>
