<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-8 px-6 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4">
      <span class="w-fit bg-amber-200 px-2 font-semibold text-gray-800">Who We Are</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Driven by Purpose, Built for Impact</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border border-gray-800 rounded p-6 flex flex-col gap-4">
        <div class="bg-white rounded border border-gray-800 w-12 h-12 flex items-center justify-center">
          <%= lucide_icon("target", class: "text-gray-800") %>
        </div>
        <h3 class="text-xl font-bold text-gray-800">Our Mission</h3>
        <p class="text-gray-600 leading-relaxed">To empower businesses across Indonesia with secure, scalable, and intelligent digital solutions — built with craftsmanship, delivered with trust, and maintained with care.</p>
      </div>
      <div class="border border-gray-800 rounded p-6 flex flex-col gap-4">
        <div class="bg-white rounded border border-gray-800 w-12 h-12 flex items-center justify-center">
          <%= lucide_icon("telescope", class: "text-gray-800") %>
        </div>
        <h3 class="text-xl font-bold text-gray-800">Our Vision</h3>
        <p class="text-gray-600 leading-relaxed">To become the most trusted technology partner in Indonesia — known for delivering solutions that genuinely move businesses forward, not just projects that ship and fade.</p>
      </div>
    </div>
  </div>
</section>
