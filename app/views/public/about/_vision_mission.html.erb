<section class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-8 px-6 shadow-md bg-white flex flex-col space-y-6">
    <div class="flex flex-col space-y-4">
      <span class="w-fit bg-amber-200 px-2 font-semibold text-gray-800">Who We Are</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Our Vision & Mission</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border border-gray-800 rounded p-6 flex flex-col gap-4">
        <div class="bg-white rounded border border-gray-800 w-12 h-12 flex items-center justify-center">
          <%= lucide_icon("telescope", class: "text-gray-800") %>
        </div>
        <h3 class="text-xl font-bold text-gray-800">Our Vision</h3>
        <p class="text-gray-600 leading-relaxed">To become a trusted technology company that delivers modern, secure, and sustainable digital solutions — upholding quality and the best standards in application development.</p>
      </div>
      <div class="border border-gray-800 rounded p-6 flex flex-col gap-4">
        <div class="bg-white rounded border border-gray-800 w-12 h-12 flex items-center justify-center">
          <%= lucide_icon("target", class: "text-gray-800") %>
        </div>
        <h3 class="text-xl font-bold text-gray-800">Our Mission</h3>
        <ul class="text-gray-600 leading-relaxed flex flex-col gap-2">
          <li class="flex items-start gap-2"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>Develop stable, secure digital solutions tailored to client needs.</li>
          <li class="flex items-start gap-2"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>Apply best practices in every development process to maintain system quality and performance.</li>
          <li class="flex items-start gap-2"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>Build client trust through professional, transparent, and reliable delivery.</li>
          <li class="flex items-start gap-2"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>Deliver technology that creates real value and supports business growth in the digital era.</li>
        </ul>
      </div>
    </div>
  </div>
</section>
