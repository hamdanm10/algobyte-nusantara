<header class="max-w-7xl mx-auto px-4 pt-36 pb-20">
  <div class="flex flex-col items-start space-y-8 max-w-2xl">
    <div class="rounded px-6 py-1 bg-white border border-gray-800 text-gray-800 text-xs flex gap-1 items-center uppercase shadow-md">
      <%= lucide_icon("building-2", class: "size-5", 'stroke-width' => '1.5') %>
      <span>About Algobyte</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-800">Realizing Your <span class="underline decoration-orange-600">Digital</span> Transformation <span class="underline decoration-orange-600">Together</span></h1>
    <p class="text-base md:text-lg text-gray-600">PT. Algobyte Teknologi Nusantara is a technology company focused on developing modern, secure, and sustainable digital solutions — built with the highest standards and delivered with trust.</p>
    <div class="flex flex-wrap gap-4">
      <%= link_to "Our Services", services_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-orange-600" %>
      <%= link_to "Get in Touch", contact_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-orange-600" %>
    </div>
  </div>
</header>
