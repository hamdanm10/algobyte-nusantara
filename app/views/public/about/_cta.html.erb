<section id="contact" class="max-w-7xl mx-auto px-4 py-10 md:py-20">
  <div class="border border-gray-800 rounded py-10 px-6 md:py-16 md:px-12 shadow-md bg-white flex flex-col items-center text-center gap-8">
    <div class="flex flex-col items-center gap-4">
      <span class="w-fit bg-rose-400 px-2 font-semibold text-gray-800">Work With Us</span>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-800">Let's Build Something Together</h2>
      <p class="text-gray-600 text-base md:text-lg max-w-2xl">Whether you have a project in mind or just want to explore how we can help, we'd love to hear from you.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-4">
      <button class="inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-rose-400">
        Start a Project
      </button>
      <%= link_to "Back to Home", root_path, class: "inline-block bg-white text-gray-800 border border-gray-800 px-6 py-3 rounded transition duration-300 hover:-rotate-5 hover:shadow-lg hover:shadow-orange-600" %>
    </div>
  </div>
</section>
