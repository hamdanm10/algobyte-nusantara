<div class="border border-gray-800 rounded p-6 flex flex-col gap-4 hover:-rotate-1 hover:shadow-lg hover:shadow-amber-200 transition duration-300">
  <div class="flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-widest text-orange-600"><%= @category %></span>
    <%= helpers.lucide_icon("arrow-up-right", class: "text-gray-400 size-4") %>
  </div>
  <h3 class="text-gray-800 font-bold text-lg"><%= @title %></h3>
  <p class="text-gray-600 text-sm leading-relaxed flex-1"><%= @description %></p>
  <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-100">
    <% @tags.each do |tag| %>
      <span class="text-xs border border-gray-800 rounded px-2 py-0.5 text-gray-600"><%= tag %></span>
    <% end %>
  </div>
</div>
