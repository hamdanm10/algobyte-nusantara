<div class="border border-gray-800 rounded p-6 flex flex-col gap-4">
  <span class="text-5xl text-gray-200 font-serif leading-none select-none">"</span>
  <p class="text-gray-600 flex-1"><%= @quote %></p>
  <div class="pt-4 border-t border-gray-200 flex items-center gap-3">
    <div class="border border-gray-800 rounded w-10 h-10 shrink-0 flex items-center justify-center bg-white">
      <span class="text-sm font-bold text-gray-800"><%= @initials %></span>
    </div>
    <div class="flex-1">
      <p class="font-bold text-gray-800 text-sm"><%= @name %></p>
      <p class="text-xs text-gray-500"><%= @role %></p>
    </div>
    <div class="flex gap-0.5">
      <% 5.times do %>
        <%= helpers.lucide_icon("star", class: "text-red-400 size-3.5 fill-red-400") %>
      <% end %>
    </div>
  </div>
</div>
