<footer class="border-t border-gray-800 mt-8 bg-white">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
      <div class="col-span-2 flex flex-col gap-4">
        <%= link_to root_path, class: "flex items-center space-x-3 rtl:space-x-reverse" do %>
          <%= image_tag "logo/color.png", class: "w-12" %>
          <span class="self-center text-2xl font-semibold whitespace-nowrap text-gray-800">AlgoByte</span>
        <% end %>
        <p class="text-gray-600 text-sm leading-relaxed">A technology company dedicated to building secure, scalable, and smart digital solutions for businesses across Indonesia.</p>
        <div class="flex gap-3 mt-2">
          <a href="#" class="border border-gray-800 rounded w-9 h-9 flex items-center justify-center hover:shadow-md hover:shadow-orange-600 transition duration-300">
            <%= helpers.lucide_icon("instagram", class: "text-gray-800 size-4") %>
          </a>
          <a href="#" class="border border-gray-800 rounded w-9 h-9 flex items-center justify-center hover:shadow-md hover:shadow-orange-600 transition duration-300">
            <%= helpers.lucide_icon("linkedin", class: "text-gray-800 size-4") %>
          </a>
          <a href="#" class="border border-gray-800 rounded w-9 h-9 flex items-center justify-center hover:shadow-md hover:shadow-orange-600 transition duration-300">
            <%= helpers.lucide_icon("github", class: "text-gray-800 size-4") %>
          </a>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <span class="text-gray-800 font-semibold text-sm uppercase tracking-widest">Company</span>
        <div class="flex flex-col gap-2">
          <%= link_to "About Us",   about_path,      class: "text-gray-600 text-sm hover:text-gray-800 transition duration-300" %>
          <%= link_to "Services",   services_path,   class: "text-gray-600 text-sm hover:text-gray-800 transition duration-300" %>
          <%= link_to "Portfolio",  portfolios_path, class: "text-gray-600 text-sm hover:text-gray-800 transition duration-300" %>
          <%= link_to "Articles",   articles_path,   class: "text-gray-600 text-sm hover:text-gray-800 transition duration-300" %>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <span class="text-gray-800 font-semibold text-sm uppercase tracking-widest">Contact</span>
        <div class="flex flex-col gap-2">
          <a href="mailto:hello@algobyte.id" class="text-gray-600 text-sm hover:text-gray-800 transition duration-300 flex items-center gap-2">
            <%= helpers.lucide_icon("mail", class: "text-gray-800 size-3.5") %>
            hello@algobyte.id
          </a>
          <a href="https://wa.me/62" class="text-gray-600 text-sm hover:text-gray-800 transition duration-300 flex items-center gap-2">
            <%= helpers.lucide_icon("phone", class: "text-gray-800 size-3.5") %>
            +62 xxx xxxx xxxx
          </a>
          <span class="text-gray-600 text-sm flex items-center gap-2">
            <%= helpers.lucide_icon("map-pin", class: "text-gray-800 size-3.5") %>
            Indonesia
          </span>
        </div>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-gray-200 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <span class="text-gray-500 text-xs">&copy; <%= Time.current.year %> Algobyte Teknologi Nusantara. All rights reserved.</span>
      <div class="flex gap-6">
        <a href="#" class="text-gray-500 text-xs hover:text-gray-800 transition duration-300">Privacy Policy</a>
        <a href="#" class="text-gray-500 text-xs hover:text-gray-800 transition duration-300">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
